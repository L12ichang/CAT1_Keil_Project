# Keil MDK Project & User files
*.uvgui.*
*.uvguix.*
*.uvoptx
*.uvopt

# Keil MDK Build Artifacts (Intermediate files)
# Typically these are in Listings/ or Objects/ folders
Listings/
Objects/
DebugConfig/
RTE/

# ARM Compiler / Keil intermediate extensions
*.o
*.obj
*.d
*.crf
*.dep
*.lnp
*.map
*.lst
*.htm
*.sct
*._ia
*.bak
*.i
*.axf
*.elf
*.idx
# J-Link / Debugger files
JLinkLog.txt
*.dbgconf
EventRecorderStub.scvd

# Firmware Products (Explicitly allowed)
# User wants to include compiled firmware
# !*.bin   # Disabled: compiled firmware should not be tracked in git
# !*.hex   # Disabled: compiled firmware should not be tracked in git

# Build logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# VS Code / IDE settings (optional but recommended to ignore)
.vscode/
.history/
