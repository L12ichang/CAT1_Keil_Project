 void mqtt_reply_set_level(void)
 {
     cJSON *root = NULL;
     char *json_str = NULL;
     // 1. 创建JSON对象
     root = cJSON_CreateObject();
     if (root == NULL) {
         printf("cJSON_CreateObject failed\r\n");
         return;
     }
     // 2. 拼装字段

     cJSON_AddStringToObject(root, "token",    sys_data.token);
     cJSON_AddNumberToObject(root, "seq_num",  seq_num);
     
     cJSON_AddStringToObject(root, "openid",   sys_data.openid);
     cJSON_AddStringToObject(root, "cmd",      "set_level");
     cJSON_AddStringToObject(root, "status",   "ok");

     // 3. 打印成字符串
     json_str = cJSON_Print(root);
     if (json_str == NULL) {
          printf("cJSON_Print NULL\r\n");
          goto exit;  // 统一释放
     }
     // 4. 安全拷贝，防止溢出
     if (strlen(json_str) >= MQTT_JSON_BUF_MAX_LEN) {
         printf("json too long, overflow risk\r\n");
         goto exit;
     }
     strcpy(_str, json_str);
     // 5. 发送MQTT
     printf("send: %s\r\n", _str);
     send_MQTT_Data("done/cmd_reply", _str);
 exit:
     // 统一释放，避免内存泄漏
     if (json_str) 
         free(json_str);
     if (root)   
         cJSON_Delete(root);
 }
 
 
 
 
 
 
 
 
 
 
