#include "sys_Vo_Io.h"
void json_process (void)
{

    if(mqtt_reply_set_level_flag)
    {
          mqtt_reply_set_level_flag=0;
          mqtt_reply_set_level();
    }
    if(upLoadPowerdata_flag)
    {
           upLoadPowerdata_flag=0;
           log_u32(100, 7);
           if(upLoadPowerdata(&Pdata)==NULL)
           {
               printf("ERR");
           }
           else
           {
           
           
           }
   }
    extern u8 bl0942data_ready; //刷新数据结构体
   if(bl0942data_ready)
   { 
       bl0942data_ready=0;
       Pdata.Vin=(float)ac_voltage_8209/10;
       Pdata.Iin=(float)Z_ac_current/1000;
       Pdata.p=(float)ac_powerpa/100;
       Pdata.Vout=(float)Vo_value/10;
       Pdata.Iout=(float)Io_value/1000;
       Pdata.bl=dim_level;
   }
   

}


