 // 定义一个足够大的全局缓冲区
static char s_json_buffer[MQTT_JSON_BUF_MAX_LEN];

int upLoadPowerdata(PowerData *pdata)
{   
    cJSON *root = NULL;
    cJSON *data_node = NULL;
    int ret = -1;
    char *json_str = NULL;

    if (pdata == NULL) { log_u32(101, 9); return -1; }

    root = cJSON_CreateObject();
    if (!root) goto JSON_ERR;

    data_node = cJSON_CreateObject();
    if (!data_node) goto JSON_ERR;

   // 添加数据逻辑不变 ...
    cJSON_AddNumberToObject(data_node, "Vin", (double)pdata->Vin);
    cJSON_AddNumberToObject(data_node, "Iin",   pdata->Iin);
    cJSON_AddNumberToObject(data_node, "p",     pdata->p);
    cJSON_AddNumberToObject(data_node, "Vout",  pdata->Vout);
    cJSON_AddNumberToObject(data_node, "Iout",  pdata->Iout);
    
   //4. 向 data 节点添加**布尔型字段**（cJSON_AddBool 自动识别0/1为false/true）
    cJSON_AddBoolToObject(data_node, "sc",     pdata->sc);
    cJSON_AddBoolToObject(data_node, "ovp",    pdata->ovp);
    cJSON_AddBoolToObject(data_node, "ol",     pdata->ol);
    cJSON_AddBoolToObject(data_node, "ot",     pdata->ot);
    cJSON_AddBoolToObject(data_node, "ovi",    pdata->ovi);
    cJSON_AddBoolToObject(data_node, "uvl",    pdata->uvl);
    cJSON_AddBoolToObject(data_node, "el",     pdata->el);
    cJSON_AddBoolToObject(data_node, "wi",     pdata->wi);
   
    
    
    
    // ... 其他字段 ...
    cJSON_AddItemToObject(root, "data", data_node);
    cJSON_AddStringToObject(root, "cmd", "get_realtime_data");
    cJSON_AddNumberToObject(root, "seq_num", (double)seq_num);
    // ... 其他字段 ...

    // 【关键修改】使用预分配缓冲区生成 JSON，避免 malloc/free
    // 注意：cJSON_PrintPreallocated 需要缓冲区足够大
    if (cJSON_PrintPreallocated(root, s_json_buffer, MQTT_JSON_BUF_MAX_LEN, 0) == 0) {
        log_u32(105, 9); // 缓冲区太小
        goto JSON_ERR;
    }
    
    // 此时 s_json_buffer 中就是 JSON 字符串，不需要 json_str 指针
    printf("send: %s\r\n", s_json_buffer);

    // 发送
    // 风险依然存在：如果 g4Send 是异步且不发拷贝，s_json_buffer 下次调用会被覆盖
    // 解决办法：在 send_MQTT_Data 内部做拷贝，或者加锁保护 s_json_buffer
    send_MQTT_Data("done/cmd_reply", s_json_buffer);
    
    // 如果 send_MQTT_Data 是异步的，这里不能立即返回让下一次调用覆盖 s_json_buffer
    // 必须确保：要么 send_MQTT_Data 内部拷贝了，要么加互斥锁保护 s_json_buffer
    
    ret = 0;
    seq_num++;

JSON_ERR:
    if (root) cJSON_Delete(root);
    // 不需要 free json_str，因为是静态缓冲区
    return ret;
}
 
