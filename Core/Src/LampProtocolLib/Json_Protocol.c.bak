#include <stdio.h>
#include <string.h>
#include "cJSON.h"

/* ================= 配置与外部依赖 ================= */
// 建议在头文件中定义这些，不要放在 .c 文件函数内
// extern typedef struct { char token[32]; } sys_data_t;
// extern sys_data_t sys_data;
// extern float dim_level;       // 建议改为 float 节省资源
// extern int seq_num;
// extern volatile uint8_t mqtt_reply_set_level_flag;
// extern volatile uint8_t upLoadPowerdata_flag;

void dim_ready(void); // 函数声明移至外部

/* ================= 辅助函数 ================= */

/**
 * @brief 安全校验 Token
 * @param root cJSON 根节点
 * @return 1: 成功, 0: 失败
 */
static int verify_token(cJSON *root)
{
    cJSON *token_node = cJSON_GetObjectItem(root, "token");
    
    // 检查是否存在且为字符串
    if (token_node == NULL || !cJSON_IsString(token_node) || token_node->valuestring == NULL)
    {
        printf("[MQTT] Error: Missing or invalid token\r\n");
        return 0;
    }

    // 比较 token (注意防止 NULL 指针)
    if (strcmp(token_node->valuestring, sys_data.token) != 0)
    {
        printf("[MQTT] Security Alert: Token mismatch!\r\n");
        return 0;
    }

    return 1;
}

/**
 * @brief 安全获取数字值
 * @param node cJSON 节点
 * @param out_val 输出指针
 * @return 1: 成功, 0: 失败
 */
static int get_safe_double(cJSON *node, double *out_val)
{
    if (node == NULL || !cJSON_IsNumber(node))
    {
        return 0;
    }
    *out_val = node->valuedouble;
    return 1;
}

/* ================= 主处理函数 ================= */

static int json_do_equals(cJSON *dt, const char *expected)
{
    cJSON *node;

    if (dt == NULL || expected == NULL)
    {
        return 0;
    }
    if (cJSON_IsString(dt) && dt->valuestring != NULL)
    {
        return strcmp(dt->valuestring, expected) == 0;
    }
    if (cJSON_IsObject(dt))
    {
        node = cJSON_GetObjectItem(dt, "do");
        if (node == NULL)
        {
            node = cJSON_GetObjectItem(dt, "Do");
        }
        if (node == NULL)
        {
            node = cJSON_GetObjectItem(dt, "DO");
        }
        if (node == NULL)
        {
            node = cJSON_GetObjectItem(dt, "cmd");
        }
        if (node != NULL && cJSON_IsString(node) && node->valuestring != NULL)
        {
            return strcmp(node->valuestring, expected) == 0;
        }
    }
    return 0;
}

void app_mqtt_rx(char *rx)
{
    cJSON *root = NULL;
    cJSON *cmd_node = NULL;
    const char *cmd_str = NULL;
    zk_message_header_t header_storage;
    zk_message_header_t *header = &header_storage;
    cJSON *dt = NULL;

    // 1. 输入合法性检查
    if (rx == NULL || *rx == '\0') 
    {
        return;
    }

    // 2. 解析 JSON
    root = cJSON_Parse(rx);
    if (root == NULL)
    {
        // 获取错误位置可方便调试 (可选)
        // const char *error_ptr = cJSON_GetErrorPtr();
        printf("[MQTT] Parse Failed\r\n");
        return; // 解析失败直接返回，无需 delete
    }

    // 3. 获取并校验 CMD
    if (zk_parse_message_header(rx, header) == 0)
    {
        dt = cJSON_GetObjectItem(root, "DT");
        if (zk_mqtt_accept_login_ack(header))
        {
            onLogInResponse(LOGIN_SUCCESS);
            goto EXIT_CLEANUP;
        }
        if (zk_mqtt_accept_heartbeat_ack(header))
        {
            goto EXIT_CLEANUP;
        }
        if (json_do_equals(dt, "patrol"))
        {
            zk_publish_error_response(header, 0);
            goto EXIT_CLEANUP;
        }
        if (zk_handle_control_message(root, header))
        {
            zk_publish_error_response(header, 0);
            goto EXIT_CLEANUP;
        }
    }

    cmd_node = cJSON_GetObjectItem(root, "cmd");
    if (cmd_node == NULL || !cJSON_IsString(cmd_node) || (cmd_str = cmd_node->valuestring) == NULL)
    {
        printf("[MQTT] Error: Invalid 'cmd' field\r\n");
        goto EXIT_CLEANUP;
    }

    // 4. 命令分发
    if (strcmp(cmd_str, "set_level") == 0)
    {
        // --- 处理 set_level ---
//        if (!verify_token(root)) 
//        {
//            goto EXIT_CLEANUP;
//        }

        cJSON *level_node = cJSON_GetObjectItem(root, "level");
        double temp_level = 0.0;

        if (get_safe_double(level_node, &temp_level))
        {
            dim_level = (float)temp_level; // 转换为 float 存储
            printf("[ACT] Level: %.2f\r\n", dim_level);
            
            dim_ready();
           mqtt_reply_set_level_flag = 1;   // 开机有个渐变，改为异步  //  mqtt_reply_set_level();
           
        }
        else
        {
            printf("[MQTT] Warning: Invalid 'level' value\r\n");
        }

        // 处理 seq_num (可选)
        cJSON *seq_node = cJSON_GetObjectItem(root, "seq_num");
        if (seq_node != NULL && cJSON_IsNumber(seq_node))
        {
            seq_num = (int)seq_node->valuedouble;
        }
    }
    else if (strcmp(cmd_str, "get_realtime_data") == 0)
    {
        // --- 处理 get_realtime_data ---
//        if (!verify_token(root))
//        {
//            goto EXIT_CLEANUP;
//        }

        printf("[ACT] Request Realtime Data\r\n");
      //  upLoadPowerdata_flag = 1;
            if(upLoadPowerdata(&Pdata)==-1)
           {
               printf("ERR");
           }
    }
    else
    {
        printf("[MQTT] Unknown Command: %s\r\n", cmd_str);
    }

EXIT_CLEANUP:
    // 5. 【关键】统一释放内存
    if (root != NULL)
    {
        cJSON_Delete(root);
    }
}

